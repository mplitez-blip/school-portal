{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-portal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-portal-db",
      "database_id": "8d83c05e-8602-498f-b8b6-8a19adb421f7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "school-portal-files"
    }
  ],
  "vars": {
    "CORS_ORIGIN": "*"
  }
}
