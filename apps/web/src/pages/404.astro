---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | School Teacher Portal">
  <main class="container" style="padding-block: 4rem; text-align: center;">
    <section class="panel-card" style="max-inline-size: 480px; margin-inline: auto;">
      <h1>Page not found</h1>
      <p class="panel-subtitle">That page does not exist. Return to the Teacher Portal to find your forms and templates.</p>
      <a href="/" class="btn btn-primary">Go to Teacher Portal</a>
    </section>
  </main>
</BaseLayout>
