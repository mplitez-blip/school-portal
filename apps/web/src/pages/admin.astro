---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin Dashboard | School Teacher Portal">
  <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>

  <header class="site-header">
    <div class="container header-inner">
      <div class="brand">
        <div id="admin-brand-icon-wrap" class="brand-icon" aria-hidden="true">
          <svg id="admin-default-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          <img id="admin-logo-img" class="brand-logo" width="48" height="48" alt="" decoding="async" hidden />
        </div>
        <div>
          <h1 id="main-content" tabindex="-1" class="brand-title">Admin Dashboard</h1>
          <p id="admin-school-subtitle" class="brand-tagline">Manage school name, submission links, templates, and downloads</p>
        </div>
      </div>

      <nav class="header-actions" aria-label="Admin">
        <a href="/" class="btn btn-ghost-light">View Teacher Portal</a>
        <button id="sign-out-btn" type="button" class="btn btn-ghost-light" hidden>Sign Out</button>
      </nav>
    </div>
  </header>

  <main class="container">
    <!-- Sign-in View -->
    <section id="login-section" class="panel-card" style="max-inline-size: 520px; margin-inline: auto;">
      <h2 id="login-heading">Admin Sign In</h2>
      <p class="panel-subtitle">
        Sign in to change the school name or manage links and files for teachers.
      </p>

      <div id="login-error" class="status-msg status-error" role="alert" hidden></div>

      <form id="login-form" aria-labelledby="login-heading" method="POST">
        <div class="field">
          <label for="login-username">Username <span aria-hidden="true">*</span></label>
          <input
            id="login-username"
            name="username"
            type="text"
            class="input"
            autocomplete="username"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="next"
            required
            data-error="login-username-error"
          />
          <div id="login-username-error" class="error-msg">
            <span role="img" aria-label="Error">❌</span> Please enter your admin username.
          </div>
        </div>

        <div class="field">
          <label for="login-password">Password <span aria-hidden="true">*</span></label>
          <div class="password-row">
            <input
              id="login-password"
              name="password"
              type="password"
              class="input"
              autocomplete="current-password"
              enterkeyhint="done"
              required
              data-error="login-password-error"
            />
            <button
              id="toggle-login-password"
              type="button"
              class="btn btn-secondary"
              aria-pressed="false"
              aria-describedby="login-pw-warning"
            >
              Show
            </button>
          </div>
          <div id="login-password-error" class="error-msg">
            <span role="img" aria-label="Error">❌</span> Please enter your password.
          </div>
          <span id="login-pw-warning" class="visually-hidden">
            Warning: this will display your password on the screen.
          </span>
        </div>

        <button id="login-submit" type="submit" class="btn btn-primary" style="width: 100%;">
          Sign In
        </button>
      </form>
    </section>

    <!-- Authenticated Admin Workspace -->
    <div id="dashboard-section" hidden>
      <div id="admin-tabs" class="tabs">
        <div class="tablist-wrap">
          <div class="tablist scroller" {...({ focusgroup: 'tablist nomemory' } as any)} aria-label="Admin sections">
            <button type="button" id="tab-school" class="tab-btn" aria-selected="true" {...({ focusgroupstart: '' } as any)}>
              School Settings
            </button>
            <button type="button" id="tab-resources" class="tab-btn" aria-selected="false">
              Links &amp; Files
            </button>
          </div>
        </div>

        <div class="tab-panels">
          <!-- Tab 1: School Settings -->
          <div role="tabpanel" aria-labelledby="tab-school" class="tab-panel">
            <div class="panel-inner">
              <section class="panel-card">
                <h2 id="school-info-heading">School Name &amp; Notice Banner</h2>
                <p class="panel-subtitle">
                  Changes appear immediately on the Teacher Portal and future Android app.
                </p>

                <div id="settings-status" class="status-msg" role="status" aria-live="polite" hidden></div>

                <form id="settings-form" aria-labelledby="school-info-heading" method="POST">
                  <div class="field">
                    <label for="school-name-input">School Name <span aria-hidden="true">*</span></label>
                    <span id="school-name-hint" class="hint">Shown at the top of the Teacher Portal (2 to 120 characters).</span>
                    <input
                      id="school-name-input"
                      name="schoolName"
                      type="text"
                      class="input"
                      minlength="2"
                      maxlength="120"
                      required
                      aria-describedby="school-name-hint"
                      data-error="school-name-error"
                    />
                    <div id="school-name-error" class="error-msg">
                      <span role="img" aria-label="Error">❌</span> Enter a school name of at least 2 characters.
                    </div>
                  </div>

                  <div class="field">
                    <label for="school-tagline-input">Subtitle / Tagline</label>
                    <span id="school-tagline-hint" class="hint">Optional short line shown under the school name.</span>
                    <input
                      id="school-tagline-input"
                      name="tagline"
                      type="text"
                      class="input"
                      maxlength="200"
                      aria-describedby="school-tagline-hint"
                    />
                  </div>

                  <div class="field">
                    <label for="school-announcement-input">Top Announcement Banner (Optional)</label>
                    <span id="school-announcement-hint" class="hint">Leave blank to hide the yellow notice strip at the top.</span>
                    <textarea
                      id="school-announcement-input"
                      name="announcement"
                      class="textarea"
                      maxlength="400"
                      aria-describedby="school-announcement-hint"
                    ></textarea>
                  </div>

                  <button id="save-settings-btn" type="submit" class="btn btn-primary">
                    Save School Settings
                  </button>
                </form>
              </section>

              <section class="panel-card">
                <h2 id="school-logo-heading">School Logo</h2>
                <p class="panel-subtitle">
                  Upload your school seal or emblem (PNG, JPG, WebP, GIF, or AVIF up to 5 MB). It appears in the portal header.
                </p>

                <div id="logo-status" class="status-msg" role="status" aria-live="polite" hidden></div>

                <form id="logo-form" aria-labelledby="school-logo-heading" method="POST">
                  <div class="logo-preview-card">
                    <div id="logo-preview-frame" class="logo-preview-frame">
                      <svg id="logo-preview-fallback" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                        <path d="M6 12v5c3 3 9 3 12 0v-5" />
                      </svg>
                      <img id="logo-preview-img" class="logo-preview-img" width="72" height="72" alt="Current school logo preview" hidden />
                    </div>
                    <div>
                      <p id="logo-preview-label" class="logo-preview-title">Using default school emblem</p>
                      <p class="hint" style="margin: 0.15rem 0 0;">Square PNG with transparent background looks best.</p>
                    </div>
                  </div>

                  <div class="field">
                    <label for="school-logo-input">Choose Logo Image</label>
                    <span id="school-logo-hint" class="hint">Drag and drop an image or click to browse (max 5 MB).</span>
                    <div id="logo-dropzone" class="file-dropzone file-dropzone-compact">
                      <input
                        id="school-logo-input"
                        name="logo"
                        type="file"
                        accept="image/png,image/jpeg,image/webp,image/gif,image/avif"
                        class="file-input-sr"
                        aria-describedby="school-logo-hint"
                        data-error="school-logo-error"
                      />
                      <div class="dropzone-body">
                        <svg
                          class="dropzone-icon"
                          width="28"
                          height="28"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                          <circle cx="8.5" cy="8.5" r="1.5" />
                          <polyline points="21 15 16 10 5 21" />
                        </svg>
                        <p id="logo-dropzone-prompt" class="dropzone-title">
                          <strong>Drag and drop a logo here</strong>, or click to browse
                        </p>
                        <p id="logo-dropzone-status" class="dropzone-meta" role="status" aria-live="polite">
                          PNG, JPG, WebP, GIF, or AVIF (max 5 MB)
                        </p>
                      </div>
                      <button id="logo-clear-selection-btn" type="button" class="btn btn-secondary btn-sm dropzone-clear" hidden>
                        Clear selection
                      </button>
                    </div>
                    <div id="school-logo-error" class="error-msg">
                      <span role="img" aria-label="Error">❌</span> <span id="school-logo-error-text">Please choose a valid image file (max 5 MB).</span>
                    </div>
                  </div>

                  <div class="logo-actions">
                    <button id="upload-logo-btn" type="submit" class="btn btn-primary">
                      Upload Logo
                    </button>
                    <button id="remove-logo-btn" type="button" class="btn btn-danger-outline" hidden>
                      Remove Logo
                    </button>
                  </div>
                </form>
              </section>

              <section class="panel-card">
                <h2 id="password-heading">Change Admin Password</h2>
                <p class="panel-subtitle">Update your sign-in password anytime.</p>

                <div id="password-status" class="status-msg" role="status" aria-live="polite" hidden></div>

                <form id="password-form" aria-labelledby="password-heading" method="POST">
                  <div class="field">
                    <label for="current-password">Current Password <span aria-hidden="true">*</span></label>
                    <input
                      id="current-password"
                      name="currentPassword"
                      type="password"
                      class="input"
                      autocomplete="current-password"
                      required
                      data-error="current-password-error"
                    />
                    <div id="current-password-error" class="error-msg">
                      <span role="img" aria-label="Error">❌</span> Please enter your current password.
                    </div>
                  </div>

                  <div class="field">
                    <label for="new-password">New Password <span aria-hidden="true">*</span></label>
                    <span id="new-password-hint" class="hint">Use at least 8 characters.</span>
                    <div class="password-row">
                      <input
                        id="new-password"
                        name="newPassword"
                        type="password"
                        class="input"
                        autocomplete="new-password"
                        minlength="8"
                        maxlength="128"
                        required
                        aria-describedby="new-password-hint"
                        data-error="new-password-error"
                      />
                      <button
                        id="toggle-new-password"
                        type="button"
                        class="btn btn-secondary"
                        aria-pressed="false"
                        aria-describedby="new-pw-warning"
                      >
                        Show
                      </button>
                    </div>
                    <div id="new-password-error" class="error-msg">
                      <span role="img" aria-label="Error">❌</span> Enter a new password with at least 8 characters.
                    </div>
                    <span id="new-pw-warning" class="visually-hidden">
                      Warning: this will display your new password on the screen.
                    </span>
                  </div>

                  <button id="save-password-btn" type="submit" class="btn btn-secondary">
                    Update Password
                  </button>
                </form>
              </section>
            </div>
          </div>

          <!-- Tab 2: Links & Files -->
          <div role="tabpanel" aria-labelledby="tab-resources" class="tab-panel" hidden="until-found">
            <div class="panel-inner">
              <section class="panel-card">
                <h2 id="add-resource-heading">Add Link or Upload File</h2>
                <p class="panel-subtitle">
                  Share a submission link (such as a Google Form) or upload a downloadable template stored in Cloudflare R2.
                </p>

                <div id="add-resource-status" class="status-msg" role="status" aria-live="polite" hidden></div>

                <form id="add-resource-form" aria-labelledby="add-resource-heading" method="POST">
                  <fieldset class="choice-group">
                    <legend>What would you like to add?</legend>
                    <div class="choice-options">
                      <label class="choice-item" for="type-link">
                        <input id="type-link" type="radio" name="resourceType" value="link" checked />
                        <span>External Link (Google Form, Docs, website)</span>
                      </label>
                      <label class="choice-item" for="type-file">
                        <input id="type-file" type="radio" name="resourceType" value="file" />
                        <span>Upload File (PDF, Word, Excel — up to 25 MB)</span>
                      </label>
                    </div>
                  </fieldset>

                  <fieldset class="choice-group">
                    <legend>Category</legend>
                    <div id="add-category-options" class="choice-options">
                      <label class="choice-item" for="cat-opt-submissions">
                        <input id="cat-opt-submissions" type="radio" name="categoryId" value="cat-submissions" checked />
                        <span>Submission Links</span>
                      </label>
                      <label class="choice-item" for="cat-opt-templates">
                        <input id="cat-opt-templates" type="radio" name="categoryId" value="cat-templates" />
                        <span>Templates</span>
                      </label>
                      <label class="choice-item" for="cat-opt-downloads">
                        <input id="cat-opt-downloads" type="radio" name="categoryId" value="cat-downloads" />
                        <span>Downloads</span>
                      </label>
                    </div>
                  </fieldset>

                  <fieldset id="add-subcategory-group" class="choice-group" hidden>
                    <legend>Subcategory (Optional)</legend>
                    <div id="add-subcategory-options" class="choice-options"></div>
                  </fieldset>

                  <div class="field">
                    <label for="res-title">Title <span aria-hidden="true">*</span></label>
                    <span id="res-title-hint" class="hint">Use a clear name teachers immediately recognize (e.g. "Daily Attendance Form").</span>
                    <input
                      id="res-title"
                      name="title"
                      type="text"
                      class="input"
                      minlength="2"
                      maxlength="140"
                      required
                      aria-describedby="res-title-hint"
                      data-error="res-title-error"
                    />
                    <div id="res-title-error" class="error-msg">
                      <span role="img" aria-label="Error">❌</span> Enter a title of at least 2 characters.
                    </div>
                  </div>

                  <div class="field">
                    <label for="res-desc">Short Description (Optional)</label>
                    <span id="res-desc-hint" class="hint">Explain when or how teachers should use this item.</span>
                    <input
                      id="res-desc"
                      name="description"
                      type="text"
                      class="input"
                      maxlength="300"
                      aria-describedby="res-desc-hint"
                    />
                  </div>

                  <div id="url-field-group" class="field">
                    <label for="res-url">Web Link (URL) <span aria-hidden="true">*</span></label>
                    <span id="res-url-hint" class="hint">Must start with https:// or http://</span>
                    <input
                      id="res-url"
                      name="url"
                      type="url"
                      class="input"
                      placeholder="https://forms.gle/..."
                      autocorrect="off"
                      autocapitalize="none"
                      spellcheck="false"
                      required
                      aria-describedby="res-url-hint"
                      data-error="res-url-error"
                    />
                    <div id="res-url-error" class="error-msg">
                      <span role="img" aria-label="Error">❌</span> Enter a valid link starting with https:// or http://.
                    </div>
                  </div>

                  <div id="file-field-group" class="field" hidden>
                    <label for="res-file">Choose File to Upload <span aria-hidden="true">*</span></label>
                    <span id="res-file-hint" class="hint">PDF, Word (.docx), Excel (.xlsx), PowerPoint, or images up to 25 MB.</span>
                    <div id="file-dropzone" class="file-dropzone">
                      <input
                        id="res-file"
                        name="file"
                        type="file"
                        class="file-input-sr"
                        aria-describedby="res-file-hint"
                        data-error="res-file-error"
                      />
                      <div class="dropzone-body">
                        <svg
                          class="dropzone-icon"
                          width="32"
                          height="32"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                          <polyline points="17 8 12 3 7 8" />
                          <line x1="12" y1="3" x2="12" y2="15" />
                        </svg>
                        <p id="file-dropzone-prompt" class="dropzone-title">
                          <strong>Drag and drop a file here</strong>, or click to browse
                        </p>
                        <p id="file-dropzone-status" class="dropzone-meta" role="status" aria-live="polite">
                          No file chosen yet (max 25 MB)
                        </p>
                      </div>
                      <button id="file-clear-btn" type="button" class="btn btn-secondary btn-sm dropzone-clear" hidden>
                        Remove file
                      </button>
                    </div>
                    <div id="res-file-error" class="error-msg">
                      <span role="img" aria-label="Error">❌</span> <span id="res-file-error-text">Please choose a file to upload.</span>
                    </div>
                  </div>

                  <div class="field">
                    <label class="choice-item" for="res-pinned">
                      <input id="res-pinned" name="isPinned" type="checkbox" />
                      <span>Pin to "Quick Access" at the top of the Teacher Portal</span>
                    </label>
                  </div>

                  <button id="add-resource-btn" type="submit" class="btn btn-primary">
                    Add to Portal
                  </button>
                </form>
              </section>

              <section class="panel-card">
                <h2>Current Links &amp; Files</h2>
                <p class="panel-subtitle">Edit details, pin important items to the top, or remove outdated links.</p>
                <div id="list-status" class="status-msg" role="status" aria-live="polite" hidden></div>
                <ul id="admin-resources-list" class="admin-list" role="list"></ul>
              </section>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Edit Resource Modal (<dialog> per modern-web-guidance: dialog) -->
  <dialog id="edit-dialog" aria-labelledby="edit-dialog-title">
    <h1 id="edit-dialog-title">Edit Item</h1>
    <div id="edit-dialog-error" class="status-msg status-error" role="alert" hidden></div>

    <form id="edit-resource-form" method="POST">
      <input id="edit-id" type="hidden" name="id" />

      <fieldset class="choice-group">
        <legend>Category</legend>
        <div class="choice-options">
          <label class="choice-item" for="edit-cat-submissions">
            <input id="edit-cat-submissions" type="radio" name="editCategoryId" value="cat-submissions" />
            <span>Submission Links</span>
          </label>
          <label class="choice-item" for="edit-cat-templates">
            <input id="edit-cat-templates" type="radio" name="editCategoryId" value="cat-templates" />
            <span>Templates</span>
          </label>
          <label class="choice-item" for="edit-cat-downloads">
            <input id="edit-cat-downloads" type="radio" name="editCategoryId" value="cat-downloads" />
            <span>Downloads</span>
          </label>
        </div>
      </fieldset>

      <fieldset id="edit-subcategory-group" class="choice-group" hidden>
        <legend>Subcategory (Optional)</legend>
        <div id="edit-subcategory-options" class="choice-options"></div>
      </fieldset>

      <div class="field">
        <label for="edit-title">Title <span aria-hidden="true">*</span></label>
        <input
          id="edit-title"
          name="title"
          type="text"
          class="input"
          minlength="2"
          maxlength="140"
          required
          autofocus
          data-error="edit-title-error"
        />
        <div id="edit-title-error" class="error-msg">
          <span role="img" aria-label="Error">❌</span> Enter a title of at least 2 characters.
        </div>
      </div>

      <div class="field">
        <label for="edit-description">Short Description</label>
        <input id="edit-description" name="description" type="text" class="input" maxlength="300" />
      </div>

      <div id="edit-url-group" class="field">
        <label for="edit-url">Web Link (URL) <span aria-hidden="true">*</span></label>
        <input
          id="edit-url"
          name="url"
          type="url"
          class="input"
          autocorrect="off"
          autocapitalize="none"
          spellcheck="false"
          data-error="edit-url-error"
        />
        <div id="edit-url-error" class="error-msg">
          <span role="img" aria-label="Error">❌</span> Enter a valid link starting with https:// or http://.
        </div>
      </div>

      <div class="field">
        <label class="choice-item" for="edit-pinned">
          <input id="edit-pinned" name="isPinned" type="checkbox" />
          <span>Pin to "Quick Access"</span>
        </label>
      </div>

      <div class="dialog-actions">
        <button id="edit-cancel-btn" type="button" class="btn btn-secondary">Cancel</button>
        <button id="edit-save-btn" type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </dialog>

  <!-- Delete Confirmation Modal (autofocus on safe Cancel button; resets returnValue on close) -->
  <dialog id="delete-dialog" aria-labelledby="delete-dialog-title">
    <h1 id="delete-dialog-title">Delete this item?</h1>
    <p id="delete-dialog-message" style="margin: 0;"></p>
    <form method="dialog" class="dialog-actions">
      <button value="cancel" class="btn btn-secondary" autofocus>Cancel</button>
      <button value="confirm" class="btn btn-danger">Delete Item</button>
    </form>
  </dialog>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>School Portal Administration</span>
      <a href="/" class="footer-link">Back to Teacher Portal</a>
    </div>
  </footer>

  <script>
    import type { PortalPayload, Resource } from '@school-portal/shared';
    import {
      adminLogin,
      changeAdminPassword,
      clearToken,
      createFileResource,
      createLinkResource,
      deleteResource,
      deleteSchoolLogo,
      fetchPortal,
      formatFileSize,
      getSavedToken,
      resolveApiAssetUrl,
      saveToken,
      updateResource,
      updateSchoolSettings,
      uploadSchoolLogo,
      verifyAdminSession,
    } from '../lib/api';
    import { initAccessibleValidation } from '../lib/form-a11y';
    import { initTabs } from '../lib/tabs';

    initAccessibleValidation(document);

    const adminBrandIconWrap = document.getElementById('admin-brand-icon-wrap') as HTMLDivElement;
    const adminDefaultIcon = document.getElementById('admin-default-icon') as unknown as SVGSVGElement;
    const adminLogoImg = document.getElementById('admin-logo-img') as HTMLImageElement;
    const loginSection = document.getElementById('login-section') as HTMLElement;
    const dashboardSection = document.getElementById('dashboard-section') as HTMLDivElement;
    const signOutBtn = document.getElementById('sign-out-btn') as HTMLButtonElement;
    const adminSubtitle = document.getElementById('admin-school-subtitle') as HTMLParagraphElement;

    // Login elements
    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const loginError = document.getElementById('login-error') as HTMLDivElement;
    const loginUsername = document.getElementById('login-username') as HTMLInputElement;
    const loginPassword = document.getElementById('login-password') as HTMLInputElement;
    const toggleLoginPw = document.getElementById('toggle-login-password') as HTMLButtonElement;
    const loginSubmitBtn = document.getElementById('login-submit') as HTMLButtonElement;

    // Settings elements
    const settingsForm = document.getElementById('settings-form') as HTMLFormElement;
    const settingsStatus = document.getElementById('settings-status') as HTMLDivElement;
    const schoolNameInput = document.getElementById('school-name-input') as HTMLInputElement;
    const schoolTaglineInput = document.getElementById('school-tagline-input') as HTMLInputElement;
    const schoolAnnouncementInput = document.getElementById('school-announcement-input') as HTMLTextAreaElement;
    const saveSettingsBtn = document.getElementById('save-settings-btn') as HTMLButtonElement;

    // School Logo elements
    const logoForm = document.getElementById('logo-form') as HTMLFormElement;
    const logoStatus = document.getElementById('logo-status') as HTMLDivElement;
    const logoPreviewFrame = document.getElementById('logo-preview-frame') as HTMLDivElement;
    const logoPreviewFallback = document.getElementById('logo-preview-fallback') as unknown as SVGSVGElement;
    const logoPreviewImg = document.getElementById('logo-preview-img') as HTMLImageElement;
    const logoPreviewLabel = document.getElementById('logo-preview-label') as HTMLParagraphElement;
