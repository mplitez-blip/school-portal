    function wirePasswordToggle(btn: HTMLButtonElement, input: HTMLInputElement): void {
      btn.addEventListener('click', () => {
        const revealed = btn.getAttribute('aria-pressed') === 'true';
        btn.setAttribute('aria-pressed', revealed ? 'false' : 'true');
        btn.textContent = revealed ? 'Show' : 'Hide';
        input.type = revealed ? 'password' : 'text';
      });
    }

    wirePasswordToggle(toggleLoginPw, loginPassword);
    wirePasswordToggle(toggleNewPw, newPasswordInput);

    function showStatus(el: HTMLDivElement, message: string, kind: 'success' | 'error'): void {
      el.textContent = message;
      el.className = `status-msg ${kind === 'success' ? 'status-success' : 'status-error'}`;
      el.hidden = false;
    }

    const MAX_UPLOAD_BYTES = 25 * 1024 * 1024;
    let dragDepth = 0;

    function setDefaultDropzonePrompt(): void {
      const strong = document.createElement('strong');
      strong.textContent = 'Drag and drop a file here';
      fileDropzonePrompt.replaceChildren(strong, document.createTextNode(', or click to browse'));
    }

    function syncFileDropzoneUI(): void {
      const file = resFileInput.files?.[0];
      if (!file) {
        resFileInput.setCustomValidity('');
        resFileErrorText.textContent = 'Please choose a file to upload.';
        fileDropzone.classList.remove('has-file');
        setDefaultDropzonePrompt();
        fileDropzoneStatus.textContent = 'No file chosen yet (max 25 MB)';
        fileClearBtn.hidden = true;
        return;
      }

      if (file.size > MAX_UPLOAD_BYTES) {
        const msg = 'File is too large. Maximum upload size is 25 MB.';
        resFileInput.setCustomValidity(msg);
        resFileErrorText.textContent = msg;
      } else {
        resFileInput.setCustomValidity('');
        resFileErrorText.textContent = 'Please choose a file to upload.';
      }

      resFileInput.dispatchEvent(new Event('input', { bubbles: true }));
      fileDropzone.classList.add('has-file');
      fileDropzonePrompt.textContent = `Selected: ${file.name}`;
      const sizeLabel = formatFileSize(file.size);
      fileDropzoneStatus.textContent = sizeLabel ? `${sizeLabel} — drop another file or click to replace` : 'File ready to upload';
      fileClearBtn.hidden = false;
    }

    function applyDroppedFile(file: File): void {
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        resFileInput.files = dt.files;
      } catch {
        // Fallback if DataTransfer assignment is unavailable
      }
      resFileInput.dispatchEvent(new Event('change', { bubbles: true }));
    }

    fileDropzone.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('#file-clear-btn') || target === resFileInput) return;
      resFileInput.click();
    });

    fileDropzone.addEventListener('dragenter', (e) => {
      e.preventDefault();
      dragDepth += 1;
      fileDropzone.classList.add('is-dragover');
      fileDropzonePrompt.textContent = 'Drop your file here to attach';
    });

    fileDropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (e.dataTransfer) {
        e.dataTransfer.dropEffect = 'copy';
      }
      fileDropzone.classList.add('is-dragover');
    });

    fileDropzone.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) {
        fileDropzone.classList.remove('is-dragover');
        syncFileDropzoneUI();
      }
    });

    fileDropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dragDepth = 0;
      fileDropzone.classList.remove('is-dragover');
      const dropped = e.dataTransfer?.files?.[0];
      if (dropped) {
        applyDroppedFile(dropped);
      } else {
        syncFileDropzoneUI();
      }
    });

    resFileInput.addEventListener('change', syncFileDropzoneUI);

    fileClearBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      resFileInput.value = '';
      syncFileDropzoneUI();
      resFileInput.focus();
    });

    function syncResourceTypeFields(): void {
      const isFile = typeFileRadio.checked;
      urlFieldGroup.hidden = isFile;
      fileFieldGroup.hidden = !isFile;
      resUrlInput.required = !isFile;
      resFileInput.required = isFile;
      if (!isFile) {
        resFileInput.setCustomValidity('');
      } else {
        syncFileDropzoneUI();
      }
    }

    function renderSubcategoryChoices(
      groupEl: HTMLFieldSetElement,
      optionsEl: HTMLDivElement,
      categoryId: string,
      inputName: string,
      idPrefix: string,
      selectedSubId: string | null
    ): void {
      const subs = (portalData?.subcategories || []).filter((s) => s.categoryId === categoryId);
      if (subs.length === 0) {
        groupEl.hidden = true;
        optionsEl.replaceChildren();
        return;
      }

      groupEl.hidden = false;
      const validSelection = selectedSubId && subs.some((s) => s.id === selectedSubId) ? selectedSubId : '';
      const choices: Array<{ value: string; label: string }> = [
        { value: '', label: 'General (No subcategory)' },
        ...subs.map((s) => ({ value: s.id, label: s.name })),
      ];

      const nodes = choices.map((choice, idx) => {
        const inputId = `${idPrefix}-${idx}`;
        const label = document.createElement('label');
        label.className = 'choice-item';
        label.htmlFor = inputId;

        const input = document.createElement('input');
        input.id = inputId;
        input.type = 'radio';
        input.name = inputName;
        input.value = choice.value;
        input.checked = choice.value === validSelection;

        const text = document.createElement('span');
        text.textContent = choice.label;

        label.append(input, text);
        return label;
      });

      optionsEl.replaceChildren(...nodes);
    }

    function syncAddSubcategories(selectedSubId: string | null = null): void {
      const selectedCat = addForm.querySelector<HTMLInputElement>('input[name="categoryId"]:checked');
      renderSubcategoryChoices(
        addSubcategoryGroup,
        addSubcategoryOptions,
        selectedCat?.value || '',
        'subcategoryId',
        'add-subcat',
        selectedSubId
      );
    }

    addCategoryOptions.addEventListener('change', () => {
      syncAddSubcategories(null);
    });

    editForm.addEventListener('change', (e) => {
      const target = e.target;
      if (target instanceof HTMLInputElement && target.name === 'editCategoryId') {
        renderSubcategoryChoices(
          editSubcategoryGroup,
          editSubcategoryOptions,
          target.value,
          'editSubcategoryId',
          'edit-subcat',
          null
        );
      }
    });

    typeLinkRadio.addEventListener('change', syncResourceTypeFields);
    typeFileRadio.addEventListener('change', syncResourceTypeFields);
    syncResourceTypeFields();
    syncFileDropzoneUI();

    function setSignedInUI(signedIn: boolean): void {
      loginSection.hidden = signedIn;
      dashboardSection.hidden = !signedIn;
      signOutBtn.hidden = !signedIn;
    }

    function renderAdminList(): void {
      if (!portalData) return;
      const categoryMap = new Map(portalData.categories.map((c) => [c.id, c.name]));
      const subcategoryMap = new Map((portalData.subcategories || []).map((s) => [s.id, s.name]));

      if (portalData.resources.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'state-card';
        empty.textContent = 'No links or files yet. Use the form above to add your first item.';
        resourcesList.replaceChildren(empty);
        return;
      }

      const items = portalData.resources.map((res) => {
        const li = document.createElement('li');
        li.className = 'admin-item';

        const info = document.createElement('div');
        info.className = 'admin-item-info';

        const badges = document.createElement('div');
        badges.className = 'card-badges';

        if (res.isPinned) {
          const pin = document.createElement('span');
          pin.className = 'badge badge-pinned';
          pin.textContent = '★ Pinned';
          badges.append(pin);
        }

        const catBadge = document.createElement('span');
        catBadge.className = 'badge';
        catBadge.textContent = categoryMap.get(res.categoryId) || 'Uncategorized';
        badges.append(catBadge);

        if (res.subcategoryId) {
          const subName = subcategoryMap.get(res.subcategoryId);
          if (subName) {
            const subBadge = document.createElement('span');
            subBadge.className = 'badge badge-subcat';
            subBadge.textContent = subName;
            badges.append(subBadge);
          }
        }

        const typeBadge = document.createElement('span');
        typeBadge.className = res.type === 'file' ? 'badge badge-file' : 'badge';
        typeBadge.textContent = res.type === 'file' ? 'R2 File' : 'External Link';
        badges.append(typeBadge);

        const title = document.createElement('h3');
        title.className = 'admin-item-title';
        title.textContent = res.title;

        const meta = document.createElement('p');
        meta.className = 'admin-item-meta';
        if (res.type === 'file') {
          const size = formatFileSize(res.fileSize);
          meta.textContent = size ? `${res.fileName} (${size})` : res.fileName || 'Uploaded file';
        } else {
          meta.textContent = res.url || '';
        }

        info.append(badges, title, meta);

        const actions = document.createElement('div');
        actions.className = 'admin-item-actions';

        const pinBtn = document.createElement('button');
        pinBtn.type = 'button';
        pinBtn.className = 'btn btn-secondary btn-sm';
        pinBtn.textContent = res.isPinned ? 'Unpin' : 'Pin';
        pinBtn.setAttribute('aria-label', `${res.isPinned ? 'Unpin' : 'Pin'} ${res.title}`);
        pinBtn.addEventListener('click', () => void togglePin(res));

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'btn btn-secondary btn-sm';
        editBtn.textContent = 'Edit';
        editBtn.setAttribute('aria-label', `Edit ${res.title}`);
        editBtn.addEventListener('click', () => openEditModal(res));

        const deleteBtn = document.createElement('button');
        deleteBtn.type = 'button';
        deleteBtn.className = 'btn btn-danger-outline btn-sm';
        deleteBtn.textContent = 'Delete';
        deleteBtn.setAttribute('aria-label', `Delete ${res.title}`);
        deleteBtn.addEventListener('click', () => openDeleteModal(res));

        actions.append(pinBtn, editBtn, deleteBtn);
        li.append(info, actions);
        return li;
      });

      resourcesList.replaceChildren(...items);
    }

    const MAX_LOGO_BYTES = 5 * 1024 * 1024;
    const ALLOWED_LOGO_MIMES = new Set(['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/avif']);
    let logoDragDepth = 0;
    let logoObjectUrl: string | null = null;
    let savedLogoUrl: string | null = null;

    function revokeLogoObjectUrl(): void {
      if (logoObjectUrl) {
        URL.revokeObjectURL(logoObjectUrl);
        logoObjectUrl = null;
      }
    }

    function applyAdminHeaderLogo(logoUrl: string | null): void {
      const resolved = resolveApiAssetUrl(logoUrl);
      if (resolved) {
        adminLogoImg.src = resolved;
        adminLogoImg.hidden = false;
        adminDefaultIcon.style.display = 'none';
        adminBrandIconWrap.classList.add('has-logo');
      } else {
        adminLogoImg.removeAttribute('src');
        adminLogoImg.hidden = true;
        adminDefaultIcon.style.display = '';
        adminBrandIconWrap.classList.remove('has-logo');
      }
    }

    adminLogoImg.addEventListener('error', () => {
      applyAdminHeaderLogo(null);
    });

    function setDefaultLogoPrompt(): void {
      const strong = document.createElement('strong');
      strong.textContent = 'Drag and drop a logo here';
      logoDropzonePrompt.replaceChildren(strong, document.createTextNode(', or click to browse'));
    }

    function renderSavedLogoPreview(logoUrl: string | null): void {
      savedLogoUrl = logoUrl;
      applyAdminHeaderLogo(logoUrl);
      removeLogoBtn.hidden = !logoUrl;

      if (logoInput.files?.[0]) return;
      const resolved = resolveApiAssetUrl(logoUrl);
      if (resolved) {
        logoPreviewImg.src = resolved;
        logoPreviewImg.hidden = false;
        logoPreviewFallback.style.display = 'none';
        logoPreviewFrame.classList.add('has-logo');
        logoPreviewLabel.textContent = 'Current live school logo';
      } else {
        logoPreviewImg.removeAttribute('src');
        logoPreviewImg.hidden = true;
        logoPreviewFallback.style.display = '';
        logoPreviewFrame.classList.remove('has-logo');
        logoPreviewLabel.textContent = 'Using default school emblem';
      }
    }

    function syncLogoPickerUI(): void {
      revokeLogoObjectUrl();
      const file = logoInput.files?.[0];
      if (!file) {
        logoInput.setCustomValidity('');
        logoErrorText.textContent = 'Please choose a valid image file (max 5 MB).';
        logoDropzone.classList.remove('has-file');
        setDefaultLogoPrompt();
        logoDropzoneStatus.textContent = 'PNG, JPG, WebP, GIF, or AVIF (max 5 MB)';
        logoClearSelectionBtn.hidden = true;
        renderSavedLogoPreview(savedLogoUrl);
        return;
      }

      let errorMsg = '';
      if (!ALLOWED_LOGO_MIMES.has(file.type.toLowerCase())) {
        errorMsg = 'Unsupported file type. Please choose a PNG, JPG, WebP, GIF, or AVIF image.';
      } else if (file.size > MAX_LOGO_BYTES) {
        errorMsg = 'Logo image is too large. Maximum size is 5 MB.';
      }

      logoInput.setCustomValidity(errorMsg);
      logoErrorText.textContent = errorMsg || 'Please choose a valid image file (max 5 MB).';
      logoInput.dispatchEvent(new Event('input', { bubbles: true }));

      logoDropzone.classList.add('has-file');
      logoDropzonePrompt.textContent = `Selected: ${file.name}`;
      const sizeLabel = formatFileSize(file.size);
      logoDropzoneStatus.textContent = sizeLabel ? `${sizeLabel} — click "Upload Logo" to publish` : 'Ready to upload';
      logoClearSelectionBtn.hidden = false;

      if (!errorMsg) {
        logoObjectUrl = URL.createObjectURL(file);
        logoPreviewImg.src = logoObjectUrl;
        logoPreviewImg.hidden = false;
        logoPreviewFallback.style.display = 'none';
        logoPreviewFrame.classList.add('has-logo');
        logoPreviewLabel.textContent = `Preview (not uploaded yet): ${file.name}`;
      }
    }

    logoDropzone.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('#logo-clear-selection-btn') || target === logoInput) return;
      logoInput.click();
    });

    logoDropzone.addEventListener('dragenter', (e) => {
      e.preventDefault();
      logoDragDepth += 1;
      logoDropzone.classList.add('is-dragover');
      logoDropzonePrompt.textContent = 'Drop your logo image here';
    });

    logoDropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
      logoDropzone.classList.add('is-dragover');
    });

    logoDropzone.addEventListener('dragleave', (e) => {
      e.preventDefault();
      logoDragDepth = Math.max(0, logoDragDepth - 1);
      if (logoDragDepth === 0) {
        logoDropzone.classList.remove('is-dragover');
        syncLogoPickerUI();
      }
    });

    logoDropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      logoDragDepth = 0;
      logoDropzone.classList.remove('is-dragover');
      const dropped = e.dataTransfer?.files?.[0];
      if (dropped) {
        try {
          const dt = new DataTransfer();
          dt.items.add(dropped);
          logoInput.files = dt.files;
        } catch {
          // Fallback if DataTransfer assignment is unavailable
        }
        logoInput.dispatchEvent(new Event('change', { bubbles: true }));
      } else {
        syncLogoPickerUI();
      }
    });

    logoInput.addEventListener('change', syncLogoPickerUI);

    logoClearSelectionBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      logoInput.value = '';
      syncLogoPickerUI();
      logoInput.focus();
    });

    logoForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!authToken) return;
      logoStatus.hidden = true;

      const file = logoInput.files?.[0];
      if (!file) {
        logoInput.setCustomValidity('Please choose an image file to upload.');
        logoErrorText.textContent = 'Please choose an image file to upload.';
        logoInput.dispatchEvent(new Event('invalid', { bubbles: false }));
        logoInput.focus();
        return;
      }

      if (!logoForm.checkValidity()) {
        logoForm.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      uploadLogoBtn.disabled = true;
      removeLogoBtn.disabled = true;
      try {
        const res = await uploadSchoolLogo(authToken, file);
        logoInput.value = '';
        savedLogoUrl = res.settings.logoUrl;
        syncLogoPickerUI();
        renderSavedLogoPreview(res.settings.logoUrl);
        showStatus(logoStatus, 'School logo updated! Teachers will now see it in the portal header.', 'success');
      } catch (err) {
        showStatus(logoStatus, err instanceof Error ? err.message : 'Failed to upload logo.', 'error');
      } finally {
        uploadLogoBtn.disabled = false;
        removeLogoBtn.disabled = false;
      }
    });

    removeLogoBtn.addEventListener('click', async () => {
      if (!authToken) return;
      logoStatus.hidden = true;
      uploadLogoBtn.disabled = true;
      removeLogoBtn.disabled = true;
      try {
        const res = await deleteSchoolLogo(authToken);
        logoInput.value = '';
        savedLogoUrl = res.settings.logoUrl;
        syncLogoPickerUI();
        renderSavedLogoPreview(res.settings.logoUrl);
        showStatus(logoStatus, 'Custom logo removed. Reverted to default school emblem.', 'success');
      } catch (err) {
        showStatus(logoStatus, err instanceof Error ? err.message : 'Failed to remove logo.', 'error');
      } finally {
        uploadLogoBtn.disabled = false;
        removeLogoBtn.disabled = false;
      }
    });

    async function loadDashboardData(): Promise<void> {
      portalData = await fetchPortal();
      schoolNameInput.value = portalData.settings.schoolName;
      schoolTaglineInput.value = portalData.settings.tagline;
      schoolAnnouncementInput.value = portalData.settings.announcement;
      adminSubtitle.textContent = `Managing: ${portalData.settings.schoolName}`;
      renderSavedLogoPreview(portalData.settings.logoUrl);
      const currentSub = addForm.querySelector<HTMLInputElement>('input[name="subcategoryId"]:checked')?.value || null;
      syncAddSubcategories(currentSub);
      renderAdminList();
    }

    async function togglePin(res: Resource): Promise<void> {
      if (!authToken) return;
      try {
        await updateResource(authToken, res.id, { isPinned: !res.isPinned });
        await loadDashboardData();
        showStatus(
          listStatus,
          res.isPinned ? `"${res.title}" removed from Quick Access.` : `"${res.title}" pinned to Quick Access.`,
          'success'
        );
      } catch (err) {
        showStatus(listStatus, err instanceof Error ? err.message : 'Failed to update item.', 'error');
      }
    }

    function openEditModal(res: Resource): void {
      editingResource = res;
      editError.hidden = true;
      editIdInput.value = res.id;
      editTitleInput.value = res.title;
      editDescInput.value = res.description;
      editPinnedInput.checked = res.isPinned;

      const radio = editForm.querySelector<HTMLInputElement>(
        `input[name="editCategoryId"][value="${CSS.escape(res.categoryId)}"]`
      );
      if (radio) radio.checked = true;
      renderSubcategoryChoices(
        editSubcategoryGroup,
        editSubcategoryOptions,
        res.categoryId,
        'editSubcategoryId',
        'edit-subcat',
        res.subcategoryId
      );

      const isLink = res.type === 'link';
      editUrlGroup.hidden = !isLink;
      editUrlInput.required = isLink;
      editUrlInput.value = res.url || '';

      editDialog.showModal();
    }

    editCancelBtn.addEventListener('click', () => {
      editDialog.close();
    });

    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!authToken || !editingResource) return;

      if (!editForm.checkValidity()) {
        editForm.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      const selectedCat = editForm.querySelector<HTMLInputElement>('input[name="editCategoryId"]:checked');
      const selectedSub = editForm.querySelector<HTMLInputElement>('input[name="editSubcategoryId"]:checked');
      editSaveBtn.disabled = true;
      editError.hidden = true;

      try {
        await updateResource(authToken, editingResource.id, {
          categoryId: selectedCat?.value,
          subcategoryId: !editSubcategoryGroup.hidden ? selectedSub?.value || null : null,
          title: editTitleInput.value.trim(),
          description: editDescInput.value.trim(),
          url: editingResource.type === 'link' ? editUrlInput.value.trim() : undefined,
          isPinned: editPinnedInput.checked,
        });
        editDialog.close();
        await loadDashboardData();
        showStatus(listStatus, 'Changes saved.', 'success');
      } catch (err) {
        showStatus(editError, err instanceof Error ? err.message : 'Could not save changes.', 'error');
      } finally {
        editSaveBtn.disabled = false;
      }
    });

    function openDeleteModal(res: Resource): void {
      pendingDelete = res;
      deleteDialogMessage.textContent =
        res.type === 'file'
          ? `Are you sure you want to delete "${res.title}" and remove its uploaded file from storage?`
          : `Are you sure you want to delete "${res.title}" from the Teacher Portal?`;
      deleteDialog.showModal();
    }

    deleteDialog.addEventListener('close', async () => {
      const choice = deleteDialog.returnValue;
      // Always reset returnValue so stale values never leak on subsequent Esc dismissals
      deleteDialog.returnValue = '';

      if (choice === 'confirm' && pendingDelete && authToken) {
        const target = pendingDelete;
        pendingDelete = null;
        try {
          await deleteResource(authToken, target.id);
          await loadDashboardData();
          showStatus(listStatus, `"${target.title}" was deleted.`, 'success');
        } catch (err) {
          showStatus(listStatus, err instanceof Error ? err.message : 'Could not delete item.', 'error');
        }
      } else {
        pendingDelete = null;
      }
    });

    // Sign In
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginError.hidden = true;

      if (!loginForm.checkValidity()) {
        loginForm.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      loginSubmitBtn.disabled = true;
      try {
        const result = await adminLogin(loginUsername.value.trim(), loginPassword.value);
        authToken = result.token;
        saveToken(result.token);
        loginForm.reset();
        setSignedInUI(true);
        await loadDashboardData();
      } catch (err) {
        showStatus(loginError, err instanceof Error ? err.message : 'Sign-in failed.', 'error');
      } finally {
        loginSubmitBtn.disabled = false;
      }
    });

    // Sign Out
    signOutBtn.addEventListener('click', () => {
      authToken = null;
      clearToken();
      setSignedInUI(false);
      adminSubtitle.textContent = 'Manage school name, submission links, templates, and downloads';
      loginUsername.focus();
    });

    // Save School Settings
    settingsForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!authToken) return;
      settingsStatus.hidden = true;

      if (!settingsForm.checkValidity()) {
        settingsForm.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      saveSettingsBtn.disabled = true;
      try {
        const res = await updateSchoolSettings(authToken, {
          schoolName: schoolNameInput.value.trim(),
          tagline: schoolTaglineInput.value.trim(),
          announcement: schoolAnnouncementInput.value.trim(),
        });
        adminSubtitle.textContent = `Managing: ${res.settings.schoolName}`;
        showStatus(settingsStatus, `Saved! Teachers will now see "${res.settings.schoolName}".`, 'success');
      } catch (err) {
        showStatus(settingsStatus, err instanceof Error ? err.message : 'Failed to save settings.', 'error');
      } finally {
        saveSettingsBtn.disabled = false;
      }
    });

    // Change Password
    passwordForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!authToken) return;
      passwordStatus.hidden = true;

      if (!passwordForm.checkValidity()) {
        passwordForm.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      savePasswordBtn.disabled = true;
      try {
        await changeAdminPassword(authToken, {
          currentPassword: currentPasswordInput.value,
          newPassword: newPasswordInput.value,
        });
        passwordForm.reset();
        showStatus(passwordStatus, 'Password updated successfully.', 'success');
      } catch (err) {
        showStatus(passwordStatus, err instanceof Error ? err.message : 'Could not change password.', 'error');
      } finally {
        savePasswordBtn.disabled = false;
      }
    });

    // Add Link or Upload File
    addForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!authToken) return;
      addStatus.hidden = true;

      if (!addForm.checkValidity()) {
        addForm.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      const selectedCat = addForm.querySelector<HTMLInputElement>('input[name="categoryId"]:checked');
      if (!selectedCat) return;
      const selectedSub = !addSubcategoryGroup.hidden
        ? addForm.querySelector<HTMLInputElement>('input[name="subcategoryId"]:checked')
        : null;
      const subcategoryId = selectedSub?.value || null;

      addBtn.disabled = true;
      try {
        if (typeFileRadio.checked) {
          const file = resFileInput.files?.[0];
          if (!file) {
            resFileInput.focus();
            return;
          }
          const formData = new FormData();
          formData.append('categoryId', selectedCat.value);
          if (subcategoryId) {
            formData.append('subcategoryId', subcategoryId);
          }
          formData.append('title', resTitleInput.value.trim());
          formData.append('description', resDescInput.value.trim());
          formData.append('isPinned', String(resPinnedInput.checked));
          formData.append('file', file);
          await createFileResource(authToken, formData);
        } else {
          await createLinkResource(authToken, {
            categoryId: selectedCat.value,
            subcategoryId,
            title: resTitleInput.value.trim(),
            description: resDescInput.value.trim(),
            url: resUrlInput.value.trim(),
            isPinned: resPinnedInput.checked,
          });
        }

        addForm.reset();
        syncResourceTypeFields();
        syncFileDropzoneUI();
        syncAddSubcategories(null);
        await loadDashboardData();
        showStatus(addStatus, 'Added! It is now visible on the Teacher Portal.', 'success');
      } catch (err) {
        showStatus(addStatus, err instanceof Error ? err.message : 'Could not add item.', 'error');
      } finally {
        addBtn.disabled = false;
      }
    });

    // Restore saved session on load
    async function bootstrap(): Promise<void> {
      const saved = getSavedToken();
      if (!saved) {
        setSignedInUI(false);
        return;
      }
      const session = await verifyAdminSession(saved).catch(() => null);
      if (session) {
        authToken = saved;
        setSignedInUI(true);
        await loadDashboardData();
      } else {
        clearToken();
        setSignedInUI(false);
      }
    }

    void bootstrap();
  </script>
</BaseLayout>
